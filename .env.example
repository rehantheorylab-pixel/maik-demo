# MAIK Kernel secrets — NEVER commit this file (encrypted at rest by secrets.py).
# Leave values empty to run on free providers only; fill escalation tiers when you have keys.

# Free provider (no key needed — works out of the box)
OPENROUTER_API_KEY=

# Escalation tiers (optional — only used when free tiers fail or confidence demands it)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Custom gateway endpoints (e.g., token-free-gateway at localhost:3456)
MAIK_GATEWAY_URL=http://localhost:3456/v1
MAIK_GATEWAY_KEY=

# Env-encryption override key (leave empty to use machine-local key)
MAIK_KEY=
