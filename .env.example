# LLM Provider (one required)
OPENAI_API_KEY=sk-your-key
# or
ANTHROPIC_API_KEY=sk-ant-your-key
# or
GEMINI_API_KEY=your-gemini-key
# or
OPENROUTER_API_KEY=sk-or-your-key

# Optional: custom model overrides
MAIK_ROUTER_MODEL=gemini/gemini-2.0-flash-001
MAIK_EXECUTOR_MODEL=openrouter/anthropic/claude-3-haiku
MAIK_SYNTHESIZER_MODEL=openrouter/openai/gpt-4o-mini

# Budget defaults
MAIK_DEFAULT_BUDGET=100000
MAIK_MAX_DEPTH=5
MAIK_FRICTION_DIAL=5
